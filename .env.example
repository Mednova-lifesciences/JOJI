# OpenAI API key used by src/lib/ai.server.ts for translation and campaign
# kit generation. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Supabase project settings > API Keys (https://supabase.com/dashboard/project/_/settings/api-keys)
# Used by src/lib/supabase.ts for auth. Safe to expose to the browser (VITE_ prefix).
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
